<Project>
  <PropertyGroup>
    <!-- Fail the build when any direct or transitive package has a known vulnerability. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pin a patched version of a transitive dependency (Avalonia.Desktop > Avalonia.X11 >
      Avalonia.FreeDesktop). 0.21.2 has GHSA-xrw6-gwf8-vvr9 (CVE-2026-39959, high).
      Remove this pin once Avalonia ships a version that depends on 0.21.3 or later.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
